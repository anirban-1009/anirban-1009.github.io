---
import Image from "astro/components/Image.astro";
import { getCollection, render } from "astro:content";
import Prose from "../../components/prose.astro";
import Layout from "../../layout/layout.astro";
export const prerender = true;

const posts = await getCollection("about");
const post = posts.find((p) => p.id === "about") || posts[0];

const aboutHeading =
  "I am Anirban Sikdar, an AIML Engineer at the intersection of Computer Science, AI, and ML. I focus on building production-ready AI systems, including agents, RAG pipelines, voice workflows, and interactive visualizations.";
const aboutDescription =
  "My background includes technical leadership as a former Student Dean and Head of Google Technologies. I’m deeply interested in Space Technology, Orbital Mechanics, and Deep Space exploration.";

if (!post) {
  throw new Error(
    "Content for 'about/about' not found. Please ensure src/content/about/about.mdx exists.",
  );
}
const { Content } = await render(post);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/*.{jpeg,jpg,png,gif,webp}",
);
if (!images[post.data.imagePath])
  throw new Error(
    `"${post.data.imagePath}" does not exist in glob: "/images/*.{jpeg,jpg,png,gif,webp}"`,
  );
---

<Layout
  title="About"
  description={post.data.description}
  imagePath="https://gitlab.com/anirban-1009/anirban.codes/-/raw/main/public/images/SocialHero.jpg?ref_type=heads"
>
  <div
    class="max-w-4xl mx-auto pt-8 pb-4 lg:pt-14 lg:flex lg:gap-12 lg:items-center lg:justify-between dark:text-primary"
  >
    <!-- Mobile About Heading -->
    <p class="lg:hidden py-4 text-4xl font-bold font-sans text-secondary dark:text-white">{post.data.title}</p>
    <div class="flex justify-center lg:hidden">
      <Image
        src={images[post.data.imagePath]()}
        alt="About Hero"
        height="280"
        width="280"
        class="rounded-full shadow-lg"
        loading="eager"
      />
    </div>
    <div class="py-6 lg:text-lg flex-1">
      <!-- Desktop About Heading -->
      <p class="hidden lg:block pb-4 text-4xl lg:text-5xl font-bold font-sans text-secondary dark:text-white">
        {post.data.title}
      </p>
      <p class="leading-relaxed text-secondary dark:text-gray-200">{aboutHeading}</p>
      <br />
      <p class="leading-relaxed text-secondary dark:text-gray-200">{aboutDescription}</p>
    </div>
    <div class="hidden lg:flex justify-center flex-shrink-0">
      <Image
        src={images[post.data.imagePath]()}
        alt="About Hero"
        height="320"
        width="320"
        class="rounded-full shadow-lg"
        loading="eager"
      />
    </div>
  </div>
  <div class="max-w-4xl mx-auto py-8">
    <Prose>
      <Content />
    </Prose>
  </div>
</Layout>
