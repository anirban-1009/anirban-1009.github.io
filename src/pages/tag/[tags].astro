---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layout/layout.astro';
import Card from '../../components/card.astro';

const { tags } = Astro.params;
type WorkPost = CollectionEntry<'work'>;
const posts: WorkPost[] = await getCollection('work', ({ data }: any) => {
  return data.isDraft !== true && Array.isArray(data.tags) && tags && data.tags.includes(tags);
});
---

<Layout title={tags || "Tagged Posts"}
  description={`All the posts related to ${tags}`}
  imagePath="https://gitlab.com/anirban-1009/anirban.codes/-/raw/main/public/images/SocialHero.jpg?ref_type=heads"
>
  <section class="py-10 min-h-[60vh]">
    <p class="text-4xl lg:text-5xl font-sans font-bold py-8 text-secondary dark:text-primary">{tags}</p>
    {posts.length === 0 ? (
      <p class="text-lg text-gray-500">No work projects found tagged with "{tags}".</p>
    ) : (
      <div class="flex flex-col lg:grid lg:grid-cols-2 gap-6 lg:gap-8">
        {
          posts.map((post) => (
            <Card
              title={post.data.title}
              description={post.data.description}
              imagePath={post.data.imagePath}
              link={`/work/${post.id}/`}
              tags={post.data.tags}
            />
          ))
        }
      </div>
    )}
  </section>
</Layout>
