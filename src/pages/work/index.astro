---
import { getCollection } from "astro:content";
import Card from "../../components/card.astro";
import Layout from "../../layout/layout.astro";
export const prerender = true;

const posts = (
  await getCollection("work", ({ data }: any) => {
    return data.isDraft !== true;
  })
).sort((a: any, b: any) => {
  const dateA = new Date(a.data.date); // Manual conversion
  const dateB = new Date(b.data.date); // Manual conversion
  return dateB.getTime() - dateA.getTime();
});
---

<Layout
  title="My Work"
  imagePath="https://gitlab.com/anirban-1009/anirban.codes/-/raw/main/public/images/SocialHero.jpg?ref_type=heads"
  description="A page detailing the work I have done over time"
>
  <section class="py-10 lg:py-14">
    <div class="mb-10 lg:mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary/10 text-primary border border-primary/20 mb-3">
        Portfolio & Systems
      </div>
      <h1 class="text-4xl lg:text-5xl font-bold font-sans tracking-tight text-secondary dark:text-white mb-3">
        Featured Work
      </h1>
      <p class="text-base lg:text-lg text-slate-600 dark:text-slate-300 max-w-2xl">
        A curated showcase of AI agents, RAG pipelines, robotics, and production systems built with performance and precision.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {
        posts.map((post: any) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            imagePath={post.data.imagePath}
            link={`/work/${post.id}/`}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
