---
import { getCollection } from "astro:content";
import Card from "../../components/card.astro";
import Layout from "../../layout/layout.astro";
export const prerender = true;

const posts = (
  await getCollection("blog", ({ data }) => {
    return data.isDraft !== true;
  })
).sort((a: any, b: any) => {
  const dateA = new Date(a.data.date); // Manual conversion
  const dateB = new Date(b.data.date); // Manual conversion
  return dateB.getTime() - dateA.getTime();
});
---

<Layout
  title="Blogs"
  description="A page detailing all the Blogs"
  imagePath="https://gitlab.com/anirban-1009/anirban.codes/-/raw/main/public/images/SocialHero.jpg?ref_type=heads"
>
  <section class="py-10 lg:py-14">
    <div class="mb-10 lg:mb-12">
      <h1
        class="text-4xl lg:text-5xl font-bold font-sans tracking-tight text-secondary dark:text-primary mb-3"
      >
        Blogs
      </h1>
      <p
        class="text-base lg:text-lg text-slate-600 dark:text-primary max-w-2xl"
      >
        Thoughts, architectural deep-dives, and tutorials on generative AI,
        autonomous agents, and software craftsmanship.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {
        posts.map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            imagePath={post.data.imagePath}
            link={`/blogs/${post.id}/`}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
