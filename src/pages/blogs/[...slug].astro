---
import Image from "astro/components/Image.astro";
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import Prose from "../../components/prose.astro";
import Layout from "../../layout/layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;
const post = Astro.props;
const { Content } = await render(post);
export const prerender = true;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/cover/*.{jpeg,jpg,png,gif,webp}",
);
if (!images[post.data.imagePath])
  throw new Error(
    `"${post.data.imagePath}" does not exist in glob: "/images/*.{jpeg,jpg,png,gif}"`,
  );

const imagePromise = images[post.data.imagePath]();
const imageData = (await imagePromise).default;
const optimizedImage = await getImage({
  src: imageData,
  format: "png",
  width: 1200,
  height: 630,
});
const ogImageUrl = new URL(
  optimizedImage.src,
  Astro.site || "https://anirbansikdar.com",
).href;
---

<Layout
  title={post.data.title}
  imagePath={ogImageUrl}
  description={post.data.description}
>
  <article class="max-w-4xl mx-auto py-8">
    <h1 class="py-4 text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-secondary dark:text-white">
      {post.data.title}
    </h1>
    <p class="pb-6 text-sm sm:text-base text-gray-500 dark:text-gray-400">
      {
        post.data.date.toLocaleDateString("en-US", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </p>
    <div class="mb-8">
      <Image
        src={images[post.data.imagePath]()}
        height="658"
        width="1600"
        alt={post.data.description}
        quality={90}
        widths={[640, 960, 1280, 1600]}
        sizes={`(max-width: 640px) 100vw, (max-width: 1280px) 960px, 1600px`}
        class="rounded-2xl w-full h-auto object-cover aspect-[17/7] shadow-md"
      />
    </div>
    <Prose>
      <Content />
    </Prose>
  </article>
</Layout>
