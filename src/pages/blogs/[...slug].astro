---
import Image from "astro/components/Image.astro";
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import Prose from "../../components/prose.astro";
import Layout from "../../layout/layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<"blog">;
const post = Astro.props;
const { Content } = await post.render();
export const prerender = true;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/images/cover/*.{jpeg,jpg,png,gif,webp}",
);
if (!images[post.data.imagePath])
  throw new Error(
    `"${post.data.imagePath}" does not exist in glob: "/images/*.{jpeg,jpg,png,gif}"`,
  );

const imagePromise = images[post.data.imagePath]();
const imageData = (await imagePromise).default;
const optimizedImage = await getImage({
  src: imageData,
  format: "png",
  width: 1200,
  height: 630,
});
const ogImageUrl = new URL(
  optimizedImage.src,
  Astro.site || "https://anirbansikdar.com",
).href;
---

<Layout
  title={post.data.title}
  imagePath={ogImageUrl}
  description={post.data.description}
>
  <article>
    <p class="py-4 lg:px-16 text-4xl lg:text-5xl lg:font-medium font-semibold">
      {post.data.title}
    </p>
    <div class="lg:px-52">
      <Image
        src={images[post.data.imagePath]()}
        height="658"
        width="1600"
        alt={post.data.description}
        quality={90}
        widths={[640, 960, 1280, 1600]}
        sizes={`(max-width: 640px) 100vw, (max-width: 1280px) 960px, 1600px`}
        class="rounded-2xl w-full h-auto object-cover aspect-[17/7]"
      />
      <p class="py-4">
        {
          post.data.date.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </p>
      <Prose>
        <div class="lg:w-screen lg:max-w-full">
          <Content />
        </div>
      </Prose>
    </div>
  </article>
</Layout>
