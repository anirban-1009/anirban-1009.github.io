---
import type { ImageMetadata } from "astro";
import Image from "astro/components/Image.astro";

interface Props {
    title: string;
    link: string;
    description: string;
    imagePath: string;
    tags?: string[];
}

const { title, link, description, imagePath, tags } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
    "/src/images/cover/*.{jpeg,jpg,png,gif,webp}",
);
if (!images[imagePath])
    throw new Error(
        `"${imagePath}" does not exist in glob: "/images/*.{jpeg,jpg,png,gif}"`,
    );
---

<div class="w-full h-full">
    <a href={link} class="group block h-full">
        <div
            class="relative flex flex-col justify-between h-full w-full p-5 lg:p-6 rounded-2xl bg-white dark:bg-[#061e2d] border border-slate-200/80 dark:border-primary/20 shadow-sm hover:shadow-xl hover:shadow-primary/10 dark:hover:shadow-primary/20 hover:border-primary/50 dark:hover:border-primary/45 transition-all duration-300 ease-out group-hover:-translate-y-1.5 overflow-hidden"
        >
            <div>
                <div class="relative overflow-hidden rounded-xl aspect-[16/9] mb-5 bg-slate-100 dark:bg-[#021824] shadow-inner">
                    <Image
                        alt={`${title}-Cover-Image`}
                        src={images[imagePath]()}
                        height="270"
                        width="480"
                        quality={85}
                        widths={[240, 540, 720]}
                        sizes={`(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 600px`}
                        class="w-full h-full object-cover object-center transform transition-transform duration-500 ease-out group-hover:scale-105"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none" />
                </div>
                <div class="flex flex-col gap-3">
                    {
                        tags && tags.length > 0 && (
                            <div class="flex flex-wrap gap-1.5">
                                {tags.map((tag) => (
                                    <span
                                        class="text-[11px] uppercase tracking-wider font-semibold px-2.5 py-0.5 rounded-full bg-primary/10 text-secondary dark:text-cyan-300 dark:bg-primary/20 border border-primary/20 transition-colors group-hover:border-primary/40"
                                    >
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        )
                    }
                    <h3 class="text-xl lg:text-2xl font-bold font-sans tracking-tight text-secondary dark:text-primary group-hover:text-primary transition-colors duration-200 line-clamp-2">
                        {title}
                    </h3>
                    <p class="text-sm lg:text-base text-slate-600 dark:text-primary leading-relaxed line-clamp-3">
                        {description}
                    </p>
                </div>
            </div>
            <div class="pt-5 mt-6 border-t border-slate-100 dark:border-primary/10 flex items-center justify-between">
                <span class="text-sm font-semibold text-primary transition-colors group-hover:text-[#188099] dark:group-hover:text-cyan-300">
                    {link.includes("/work") ? "Explore Project" : "Read Article"}
                </span>
                <div class="w-8 h-8 rounded-full bg-primary/10 dark:bg-primary/20 text-primary flex items-center justify-center transition-all duration-300 group-hover:bg-primary group-hover:text-white group-hover:translate-x-1 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                </div>
            </div>
        </div>
    </a>
</div>
